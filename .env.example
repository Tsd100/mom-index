# ============================================================
# 宝妈指数 · 环境变量配置（复制为 .env 并修改）
# ============================================================

# Web 服务端口（默认 8080）
WEBSERVER_PORT=8503

# 定时采集（cron 表达式，留空则仅启动 Web 服务）
# 示例：每天早上 9 点和下午 3 点运行
# CRON_SCHEDULE="0 9,15 * * *"

# 数据目录（Docker 容器内自动设置，一般无需修改）
# MOM_INDEX_DATA_DIR=

# 小红书 API Key（可选，留空则跳过小红书采集）
# XHS_API_KEY=

# 小红书模拟数据开关（仅演示用；生产环境保持关闭，保证数据真实）
# XHS_ALLOW_MOCK=0

# 股吧采集页数（默认 3 页，翻页后样本更充分）
# GUBA_PAGES=3

# 雪球数据源（默认关闭；需要有效登录 Cookie）
# MOM_INDEX_ENABLE_XUEQIU=0
# XUEQIU_COOKIE=

# LLM 抽查复核（可选：设置 API Key 后，按采样率用大模型复核规则引擎拿不准的帖子）
# MOM_INDEX_LLM_API_KEY=
# MOM_INDEX_LLM_BASE_URL=https://api.openai.com/v1
# MOM_INDEX_LLM_MODEL=gpt-4o-mini
# MOM_INDEX_LLM_SAMPLE_RATE=0.05

# 历史价格回填天数（腾讯K线，默认 30 天）
# BACKFILL_DAYS=30
