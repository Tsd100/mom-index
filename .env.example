# 默认每天上海时间17:00运行，首次启动立即采集一次。
NAS_PORT=8503
COLLECTION_TIME=17:00
RUN_ON_STARTUP=1
GUBA_PAGES=3
# NAS_PORT替代原WEBSERVER_PORT，COLLECTION_TIME替代原CRON_SCHEDULE。
# 默认不启用收费数据源、LLM或登录态来源；凭据仅在NAS本地.env填写。
# 小红书HTTP API（无key则跳过；生产不启用模拟数据）
# RNODE_API_KEY=
# 雪球（需有效登录Cookie）
# MOM_INDEX_ENABLE_XUEQIU=0
# XUEQIU_COOKIE=
# 可选LLM抽查复核
# MOM_INDEX_LLM_API_KEY=
# MOM_INDEX_LLM_BASE_URL=https://api.openai.com/v1
# MOM_INDEX_LLM_MODEL=gpt-4o-mini
# MOM_INDEX_LLM_SAMPLE_RATE=0.05
